# JWT 认证（必填，请使用随机长字符串）
JWT_SECRET=your-random-secret-key-here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-here

# 数据库连接（Supabase PostgreSQL）
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ggdmzbbfzcetinydgrds.supabase.co:5432/postgres

# 智谱 AI API Key
ZHIPUAI_API_KEY=8b2e1f2710a94a569c10feb88760e361.bssZHp9cp6Kv6dgn
ZHIPUAI_MODEL=glm-4-flash

# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 服务端口
PORT=3000

# Feature Flag 灰度白名单(逗号分隔的 userId)
# INTERNAL_USER_IDS:内部用户 → 激活 V3.0 LLM_TOOL_CALLING_LOOP 等 internal-only flag
# BETA_USER_IDS:    内测用户 → 激活 beta-only flag
# 留空时所有用户都按 'all' 段处理(V3.0 安全降级到 V2 旧链路)
INTERNAL_USER_IDS=
BETA_USER_IDS=
