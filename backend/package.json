{
  "name": "backend",
  "version": "1.0.0",
  "description": "哈吉咪养成计划后端API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec \"ts-node --transpile-only\" src/server.ts",
    "build": "mkdir -p ../api && NODE_TLS_REJECT_UNAUTHORIZED=0 prisma generate && esbuild src/server.ts --bundle --platform=node --target=node20 --format=cjs --outfile=../api/_server.js --external:@prisma/client --external:@prisma/adapter-pg --external:pg",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node src/seed/index.ts",
    "db:studio": "prisma studio",
    "db:test-data": "ts-node src/seed/test-data.ts",
    "eval:prompt": "ts-node src/eval/prompt-eval.ts",
    "test": "cd .. && npx vitest run --config vitest.backend.config.ts",
    "test:unit": "cd .. && npx vitest run --config vitest.backend.config.ts --root backend/src/__tests__",
    "test:api": "cd .. && npx vitest run --config vitest.api.config.ts",
    "test:watch": "cd .. && npx vitest --config vitest.backend.config.ts",
    "test:coverage": "cd .. && npx vitest run --config vitest.backend.config.ts --coverage",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "cat",
    "pet-care",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@types/multer": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "pg": "^8.20.0",
    "zhipuai": "^1.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.2",
    "@types/node-cron": "^3.0.11",
    "@types/node-fetch": "^2.6.13",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.28.0",
    "nodemon": "^3.1.11",
    "prisma": "^6.19.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
