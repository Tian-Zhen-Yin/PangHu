generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// 成长阶段
model Stage {
  id          String   @id @default(cuid())
  name        String   // 阶段名称
  ageRange    String   // 年龄范围
  description String   // 阶段描述
  order       Int      // 排序顺序
  minAgeWeeks Int      // 最小周数
  maxAgeWeeks Int?     // 最大周数（成年期为null）

  milestones  Milestone[]
  tasks       Task[]
  vaccines    Vaccine[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 里程碑
model Milestone {
  id          String   @id @default(cuid())
  title       String
  description String
  ageWeeks    Int
  icon        String?
  stageId     String
  stage       Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

// 任务清单
model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   // health, feeding, training, care
  priority    Int      // 1-高，2-中，3-低
  stageId     String
  stage       Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

// 疫苗接种
model Vaccine {
  id          String   @id @default(cuid())
  name        String
  ageWeeks    Int
  description String?
  stageId     String
  stage       Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

// 指南分类
model GuideCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String?
  description String?
  order       Int

  guides      Guide[]

  createdAt   DateTime @default(now())
}

// 知识指南
model Guide {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  content     String        // Markdown
  excerpt     String?
  coverImage  String?
  viewCount   Int           @default(0)
  categoryId  String
  category    GuideCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tags        String?       // JSON数组
  chunks      GuideChunk[]  // 关联的知识块

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// 知识块（用于 RAG 检索）
model GuideChunk {
  id          String   @id @default(cuid())
  guideId     String
  guide       Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)

  content     String   // 切分后的纯文本内容
  chunkIndex  Int      // 块在原文档中的顺序索引

  // 元数据过滤维度
  category    String   // 例如: "健康医疗", "喂养营养"
  ageStage    String?  // 例如: "幼猫期", "成年期"
  headings    String?  // JSON数组，存储标题路径 ["H1", "H2", "H3"]

  // 向量存储 (SQLite 不支持原生向量类型，使用 JSON 字符串存储)
  embedding   String?  // JSON字符串存储的向量数组

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([guideId])
  @@index([category])
}

// 计划模板
model Template {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  stageId     String?
  content     String   // JSON

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 用户
model User {
  id             String         @id @default(cuid())
  email          String         @unique
  username       String         @unique
  password       String
  plans          UserPlan[]
  petRecords     PetRecord[]
  conversations  Conversation[]
  cats           Cat[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

// 猫咪档案
model Cat {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  avatar       String?
  breed        String?
  gender       String    @default("unknown") // "male" | "female" | "unknown"
  birthDate    DateTime
  adoptDate    DateTime?

  weight       Float?
  isNeutered   Boolean   @default(false)
  neuteredDate DateTime?

  color        String?
  features     String?
  allergies    String?
  diseases     String?

  isActive     Boolean   @default(true)

  records      PetRecord[]
  vaccines     VaccineRecord[]
  conversations Conversation[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([userId, isActive])
}

// 疫苗接种记录
model VaccineRecord {
  id           String   @id @default(cuid())
  catId        String
  cat          Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)

  vaccineName  String
  vaccineType  String   @default("综合疫苗")
  manufacturer String?
  batchNumber  String?

  vaccinatedAt DateTime
  nextDueDate  DateTime?
  veterinarian String?
  clinic       String?

  reaction     String?
  notes        String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([catId])
  @@index([catId, vaccinatedAt])
}

// 用户计划（保存的模板）
model UserPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId  String   // 关联的模板ID
  name        String   // 用户自定义的计划名称
  progress    String   @default("{}") // JSON格式的进度数据
  isActive    Boolean  @default(false) // 是否为当前激活的计划

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// 宠物成长记录
model PetRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  catId       String?
  cat         Cat?     @relation(fields: [catId], references: [id], onDelete: SetNull)

  petName     String   @default("猫咪")
  photoUrl    String
  ageWeeks    Int
  ageMonths   Int
  weight      Float
  notes       String?

  recordDate  DateTime @default(now())

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, recordDate])
  @@index([catId])
}

// AI对话会话
model Conversation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  catId       String?
  cat         Cat?     @relation(fields: [catId], references: [id], onDelete: SetNull)

  title       String   @default("新对话")
  messages    Message[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([catId])
}

// AI聊天消息
model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role           String        // 'user' | 'assistant' | 'system'
  content        String        // 消息内容
  markdownContent String?      // Markdown格式（AI回复）

  referencedGuides String?     // 引用的指南ID（JSON数组）
  metadata        String?      // tokensUsed, model, latency等（JSON）

  createdAt       DateTime     @default(now())

  @@index([conversationId, createdAt])
}
