generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// 成长阶段
model Stage {
  id          String   @id @default(cuid())
  name        String   // 阶段名称
  ageRange    String   // 年龄范围
  description String   // 阶段描述
  order       Int      // 排序顺序
  minAgeWeeks Int      // 最小周数
  maxAgeWeeks Int?     // 最大周数（成年期为null）

  milestones  Milestone[]
  tasks       Task[]
  vaccines    Vaccine[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 里程碑
model Milestone {
  id          String   @id @default(cuid())
  title       String
  description String
  ageWeeks    Int
  icon        String?
  stageId     String
  stage       Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

// 任务清单
model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   // health, feeding, training, care
  priority    Int      // 1-高，2-中，3-低
  stageId     String
  stage       Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

// 疫苗接种
model Vaccine {
  id          String   @id @default(cuid())
  name        String
  ageWeeks    Int
  description String?
  stageId     String
  stage       Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

// 指南分类
model GuideCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String?
  description String?
  order       Int

  guides      Guide[]

  createdAt   DateTime @default(now())
}

// 知识指南
model Guide {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  content     String        // Markdown
  excerpt     String?
  coverImage  String?
  viewCount   Int           @default(0)
  categoryId  String
  category    GuideCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tags        String?       // JSON数组

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// 计划模板
model Template {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  stageId     String?
  content     String   // JSON

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 用户
model User {
  id             String         @id @default(cuid())
  email          String         @unique
  username       String         @unique
  password       String
  plans          UserPlan[]
  petRecords     PetRecord[]
  conversations  Conversation[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

// 用户计划（保存的模板）
model UserPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId  String   // 关联的模板ID
  name        String   // 用户自定义的计划名称
  progress    String   @default("{}") // JSON格式的进度数据
  isActive    Boolean  @default(false) // 是否为当前激活的计划

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// 宠物成长记录
model PetRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  petName     String   @default("猫咪") // 宠物名称（支持多只宠物）
  photoUrl    String   // 照片存储路径
  ageWeeks    Int      // 年龄（周）
  ageMonths   Int      // 年龄（月）- 用于显示
  weight      Float    // 体重（kg）
  notes       String?  // 备注

  recordDate  DateTime @default(now()) // 记录日期

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, recordDate])
}

// AI对话会话
model Conversation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String   @default("新对话")
  messages    Message[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, updatedAt])
}

// AI聊天消息
model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role           String        // 'user' | 'assistant' | 'system'
  content        String        // 消息内容
  markdownContent String?      // Markdown格式（AI回复）

  referencedGuides String?     // 引用的指南ID（JSON数组）
  metadata        String?      // tokensUsed, model, latency等（JSON）

  createdAt       DateTime     @default(now())

  @@index([conversationId, createdAt])
}
