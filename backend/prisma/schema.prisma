generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// 成长阶段
model Stage {
  id          String   @id @default(cuid())
  name        String   // 阶段名称
  ageRange    String   // 年龄范围
  description String   // 阶段描述
  order       Int      // 排序顺序
  minAgeWeeks Int      // 最小周数
  maxAgeWeeks Int?     // 最大周数（成年期为null）

  milestones  Milestone[]
  tasks       Task[]
  vaccines    Vaccine[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 里程碑
model Milestone {
  id          String   @id @default(cuid())
  title       String
  description String
  ageWeeks    Int
  icon        String?
  stageId     String
  stage       Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

// 任务清单
model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   // health, feeding, training, care
  priority    Int      // 1-高，2-中，3-低
  stageId     String
  stage       Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

// 疫苗接种
model Vaccine {
  id          String   @id @default(cuid())
  name        String
  ageWeeks    Int
  description String?
  stageId     String
  stage       Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

// 指南分类
model GuideCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String?
  description String?
  order       Int

  guides      Guide[]

  createdAt   DateTime @default(now())
}

// 知识指南
model Guide {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  content     String        // Markdown
  excerpt     String?
  coverImage  String?
  viewCount   Int           @default(0)
  categoryId  String
  category    GuideCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tags        String?       // JSON数组

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// 计划模板
model Template {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  stageId     String?
  content     String   // JSON

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
