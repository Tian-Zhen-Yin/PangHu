# Default: let git auto-detect text files and normalize to LF on commit
* text=auto eol=lf

# Shell scripts must use LF (otherwise they break on macOS/Linux)
*.sh           text eol=lf
*.bash         text eol=lf

# macOS / Linux config files
*.plist        text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf

# Web / source code (cross-platform projects standardize on LF)
*.js           text eol=lf
*.cjs          text eol=lf
*.mjs          text eol=lf
*.ts           text eol=lf
*.tsx          text eol=lf
*.vue          text eol=lf
*.json         text eol=lf
*.css          text eol=lf
*.scss         text eol=lf
*.html         text eol=lf
*.md           text eol=lf
*.prisma       text eol=lf

# Windows-only files keep CRLF
*.ps1          text eol=crlf
*.bat          text eol=crlf
*.cmd          text eol=crlf

# Binary files (never normalize)
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.ico          binary
*.svg          text eol=lf
*.pdf          binary
*.zip          binary
*.tar          binary
*.tar.gz       binary
*.gz           binary
*.woff         binary
*.woff2        binary
*.ttf          binary
*.eot          binary
*.db           binary
