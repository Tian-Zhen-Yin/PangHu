# Docker 部署环境变量模板:cp .env.docker.example .env 后填 ZHIPUAI_API_KEY

# 智谱 AI API Key(必填,https://open.bigmodel.cn 免费申请;glm-4.5-flash 免费额度即可运行)
ZHIPUAI_API_KEY=your-zhipuai-api-key-here
ZHIPUAI_MODEL=glm-4.5-flash

# 登录态签名密钥(强烈建议设为固定随机长字符串,留空则每次重启随机生成、登录态失效)
JWT_SECRET=
JWT_REFRESH_SECRET=

# 服务对外端口
PORT=3000

# 首次启动写入演示数据(示例猫/成长记录/知识库文章):1 开启,留空关闭
SEED_ON_START=1
