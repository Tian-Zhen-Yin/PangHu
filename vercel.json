{
  "buildCommand": "cd backend && npm install && npx prisma generate && cd ../frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@4",
      "maxDuration": 30,
      "includeFiles": [
        "backend/node_modules/**",
        "backend/prisma/**",
        "backend/src/**"
      ]
    }
  }
}
