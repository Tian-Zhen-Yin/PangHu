{
  "builds": [
    {
      "src": "api/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/node_modules/.prisma/**",
          "backend/node_modules/@prisma/client/**"
        ]
      }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/server.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "api/server.js"
    },
    {
      "src": "/cats/(.*)",
      "dest": "api/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1",
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/index.html"
    }
  ]
}
